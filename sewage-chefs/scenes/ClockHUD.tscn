[gd_scene format=3 uid="uid://bkf1qt6gylasi"]

[sub_resource type="GDScript" id="GDScript_63n3r"]
script/source = "extends CanvasLayer

@onready var time_of_day_label: Label = $UIContainer/VBoxContainer/TimeOfDayLabel
@onready var countdown_label: Label = $UIContainer/VBoxContainer/TimerCountdownLabel

var time_left_seconds: float = 180.0 # 3 minutes per shift
var is_active: bool = true

var start_hour: int = 8
var total_shift_hours: float = 12.0 # 08:00 to 20:00

func _ready() -> void:
	visible = true

func _process(delta: float) -> void:
	if not is_active:
		return

	time_left_seconds -= delta

	if time_left_seconds <= 0.0:
		time_left_seconds = 0.0
		is_active = false
		_on_deadline_reached()

	_update_display()

func _update_display() -> void:
	var minutes: int = int(time_left_seconds) / 60
	var seconds: int = int(time_left_seconds) % 60
	countdown_label.text = \"Due In: %02d:%02d\" % [minutes, seconds]

	var progress: float = 1.0 - (time_left_seconds / 180.0)
	var current_float_hour: float = float(start_hour) + (progress * total_shift_hours)
	var current_hour: int = int(current_float_hour)
	var current_minute: int = int((current_float_hour - float(current_hour)) * 60.0)

	time_of_day_label.text = \"Time: %02d:%02d\" % [current_hour, current_minute]

func _on_deadline_reached() -> void:
	print(\"Time's up! Don Parmesan is here for the €50!\")
"

